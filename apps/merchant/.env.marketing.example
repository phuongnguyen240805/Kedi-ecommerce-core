# Marketing overlay only. Merge into the existing root .env used for deployment;
# do not replace existing payment/POS/store configuration. Never deploy this file as-is.
# Instructions: plans/kedimuse-marketing-configuration.md
MARKETING_ENABLED=false
MARKETING_SEND_ENABLED=false
MARKETING_POLICY_VERSION=
MARKETING_FROM_EMAIL=
MARKETING_CONTACT_ADDRESS=
MARKETING_MAILGUN_DOMAIN=
MARKETING_MAILGUN_BASE_URL=https://api.mailgun.net
MARKETING_WELCOME_DISCOUNT_CODE=

# Server-only secrets. Leave blank until obtained/generated.
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
MARKETING_BFF_TOKEN=
# Preserve the existing signing secret. Generate only when the store has none.
ORDER_TOKEN_SECRET=

# Preserve current values; change only when the storefront/backend origin changes.
STORE_NAME=KediMuse
STORE_URL=https://printerval.gofiber-phuongnguyen.workers.dev
STORE_PUBLIC_API_URL=https://merchant.gofiber-phuongnguyen.workers.dev

# Optional AI copy drafting. Not required by the four email automations.
MARKETING_AI_ENABLED=false
MARKETING_AI_MODEL=
MARKETING_OPENAI_API_KEY=
