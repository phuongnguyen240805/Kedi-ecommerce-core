{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "printerval-cdn",
  "main": "src/cdn/worker.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    "directory": ".wrangler/printerval-cdn-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "IMAGE_CDN_ALLOWED_HOSTS": "content.pancake.vn,statics.pancake.vn,images.unsplash.com,res.cloudinary.com,cdn-printerval.prtvstatic.com,asset.prtvstatic.com"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
