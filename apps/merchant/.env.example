# Cloudflare resource bindings (NOT .env strings): MERCHANT Durable Object, KV_CACHE KV.
# Optional R2 bindings remain deferred: IMAGES, DIGITAL_ASSETS_BUCKET, COMMERCE_EVIDENCE_BUCKET.
# CARRIER_SECRETS_JSON format: {"printerval-ghn":{"token":"<GHN token>"}}
