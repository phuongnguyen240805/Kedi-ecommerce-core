PANCAKE_BASE_URL=https://pos.pages.fm/api/v1
PANCAKE_SHOP_ID=715159313
PANCAKE_API_KEY=<server-only secret>
PANCAKE_WAREHOUSE_ID=<warehouse ID verified by Pancake API>
PANCAKE_SYNC_ENABLED=false
STORE_SECRETS_JSON='{"printerval":{"PANCAKE_API_KEY":"<store-specific POS secret>","SETUP_INIT_TOKEN":"<store-specific bootstrap secret>","ORDER_TOKEN_SECRET":"<random signing secret at least 32 characters>"}}'
IMAGE_CDN_URL=
IMAGE_CDN_ALLOWED_HOSTS=content.pancake.vn,statics.pancake.vn,images.unsplash.com,res.cloudinary.com
SMART_SHIPPING_ENABLED=false
GHN_ENVIRONMENT=production
GHN_TOKEN=<server-only GHN API token; not Pancake key or OTP>
GHN_SHOP_ID=6637288
GHN_FROM_DISTRICT_ID=<GHN pickup district ID>
GHN_FROM_WARD_CODE=<GHN pickup ward code; preserve leading zeros>
# Example only. Confirm measured parcel size/weight capacity and delivery SLA before enabling.
SMART_SHIPPING_POLICY={"version":"1","max_delivery_hours":24,"subsidy_vnd":0,"parcel":{"length_cm":40,"width_cm":30,"height_cm":35,"max_weight_g":10000,"packaging_weight_g":0}}

# Phase 1. Keep disabled until staging checkout and POS money mapping pass UAT.
COMMERCE_CHECKOUT_ENABLED=false
COMMERCE_ENVIRONMENT=staging
TECHCOMBANK_ACCOUNT_NUMBER=50398838675
TECHCOMBANK_ACCOUNT_NAME=NGUYEN XUAN PHUONG
ORDER_TOKEN_SECRET=<random signing secret at least 32 characters>
SETUP_INIT_TOKEN=<random bootstrap secret>
PANCAKE_ORDER_SYNC_ENABLED=false
PANCAKE_PAYMENT_MAPPING_VERIFIED=false
# Catalog via ctxlayer (opt-in; keep private values in .dev.vars, not this file).
# PANCAKE_CATALOG_SOURCE=ctxlayer_mcp
# CTXLAYER_MCP_ENABLED=true
# CTXLAYER_MCP_URL=https://localhost:8787/mcp
# CTXLAYER_OAUTH_REDIRECT_URI=http://localhost:8788/v1/integrations/ctxlayer/callback
# CTXLAYER_PRINCIPAL_ID=<dedicated ctxlayer integration user ID>
# CTXLAYER_PANCAKE_UPSTREAM_SLUG=up-pancake-pos
# CTXLAYER_TOKEN_KEY=<base64 random 32-byte private key>

# Enable only after validating the Pancake GHN dispatch contract for this account.
PANCAKE_GHN_DISPATCH_ENABLED=false
PANCAKE_GHN_ACCOUNT_ID=<connected GHN account ID returned by Pancake /partners>

# Marketing configuration is documented separately to avoid replacing existing settings.
# Merge only filled values from .env.marketing.example into the root deployment .env.
# See ../../plans/kedimuse-marketing-configuration.md.
