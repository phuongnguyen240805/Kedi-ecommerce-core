{
  "name": "merchant",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "MERCHANT",
        "class_name": "MerchantDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MerchantDO"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE"
    }
  ],
  "vars": {
    "IMAGES_URL": "",
    "STORE_URL": "https://printerval.gofiber-phuongnguyen.workers.dev",
    "CHECKOUT_ENABLED": "true",
    "ACP_ENABLED": "false",
    "ACP_ACCESS_VERIFIED": "false"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "dev": {
    "port": 8787
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
